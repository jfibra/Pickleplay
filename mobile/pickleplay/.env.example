# Copy to .env for your own settings (Expo loads .env automatically; it is gitignored).
# EXPO_PUBLIC_* values are inlined into the bundle: restart with `expo start -c` after changing them.

# true = offline prototype with sample accounts (src/mocks). `npm run start:prototype` sets it for you.
EXPO_PUBLIC_USE_MOCKS=false

# Point the app at another Supabase project (e.g. staging). Leave empty to use production.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API (QR login approval). Defaults to http://localhost:5001.
EXPO_PUBLIC_API_BASE_URL=
