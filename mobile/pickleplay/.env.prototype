# The clickable prototype: every screen on the sample accounts, no Supabase, no API calls.
# Read by `npm run start:prototype` instead of .env. Committed: it holds no secrets, and must not.
# Sign in as player@, coach@, owner@, manager@ or admin@pickleplay.test with any 6+ character password.
EXPO_PUBLIC_USE_MOCKS=true
# Left empty: prototype mode never contacts Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
